+}
+
+uint64_t tooie::guest_clock::wait_vi(uint64_t total_vis, const std::atomic_bool& exited) {
+    using namespace std::chrono_literals;
+    // Upstream VI arithmetic over guest time: deadline total_vis/60 s, count below.
+    const std::chrono::steady_clock::duration target = (total_vis * 1000000us) / 60;
+    for (;;) {
+        uint32_t seen;
+        std::chrono::steady_clock::time_point next;
+        {
+            std::lock_guard lock{guest_map.mutex};
+            seen = guest_map.revision.load(std::memory_order_relaxed);
+            next = guest_host_point_locked(target);
+        }
+        guest_sleep_until(next);
+        // An applied change during the sleep, including 1->2->1, moves the revision.
+        if (exited.load() || guest_map.revision.load(std::memory_order_acquire) == seen) break;
+    }
+    std::lock_guard lock{guest_map.mutex};
+    return (guest_elapsed_locked(std::chrono::steady_clock::now()) * 60 / 1000ms) + 1;
+}
