+// Applies the tooie::timing request under the existing timer request owner.
+// The request is read inside request_mutex, so the latest notification (or the
+// initial application in init_timers) always ends on the latest request.
+static void guest_rate_changed() noexcept {
+    const char* failure = nullptr;
+    try {
+        std::lock_guard request{timer_context.request_mutex};
+        const uint32_t requested = tooie::timing::rate();
+        std::lock_guard lock{guest_map.mutex};
+        if (requested == guest_map.rate) return;
+        const bool engaged = guest_map.engaged.load(std::memory_order_relaxed);
+        bool woke = true;
+        try {
+            publish_timer_action(ClockRateChanged{});
+        } catch (const std::exception&) {
+            woke = false;
+        }
+        if (!woke && !engaged) {
+            // An unengaged worker may sit in an unsliced upstream wait: stay 1x.
+            // The next release/press cycle notifies again and retries.
+            failure = "baseline fast-forward refused: timer wake publication failed; staying 1x\n";
+        } else {
+            if (!woke) failure = "baseline fast-forward: timer wake publication failed; engaged 2 ms worker slice bounds the change\n";
+            const auto now = std::chrono::steady_clock::now();
+            guest_map.guest_anchor = guest_elapsed_locked(now);
+            guest_map.host_anchor = now;
+            guest_map.rate = requested;
+            guest_map.engaged.store(true, std::memory_order_release);
+            guest_map.revision.fetch_add(1, std::memory_order_release);
+        }
+    } catch (...) {
+        tooie::lifecycle::fail(std::current_exception());
+        failure = "baseline fast-forward: rate change not applied (timer request lock failed)\n";
+    }
+    if (failure) {
+        std::fputs(failure, stderr);
+        std::fflush(stderr);
+    }
+}
