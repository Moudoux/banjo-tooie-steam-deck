+// F6 compatibility boundary. Guest time and every selected timer/VI deadline use
+// steady_clock. Where high_resolution_clock is steady_clock (pinned MSVC),
+// steady_start is start_time itself, so the unengaged paths compute exactly the
+// upstream values. Elsewhere steady_start is an independent steady epoch sampled
+// in the same static initialization, right after start_time; it is never
+// converted to or from start_time, which keeps serving the public
+// get_start()/time_since_start().
+constexpr bool guest_clock_is_upstream =
+    std::is_same_v<std::chrono::high_resolution_clock, std::chrono::steady_clock>;
+template <class Clock>
+static std::chrono::steady_clock::time_point guest_steady_epoch(const typename Clock::time_point& upstream) {
+    if constexpr (std::is_same_v<Clock, std::chrono::steady_clock>) return upstream;
+    else return std::chrono::steady_clock::now();
+}
+static const std::chrono::steady_clock::time_point steady_start =
+    guest_steady_epoch<std::chrono::high_resolution_clock>(start_time);
+
+struct GuestMap {
+    std::mutex mutex;
+    std::atomic_bool engaged{false};
+    std::atomic_uint32_t revision{0};
+    std::chrono::steady_clock::time_point host_anchor{};
+    std::chrono::steady_clock::duration guest_anchor{};
+    uint32_t rate = 1;
+};
+static GuestMap guest_map;
+
+// Engaged callers sample steady now under guest_map.mutex after the rebase that
+// set host_anchor, so the host interval is never negative.
+static std::chrono::steady_clock::duration guest_elapsed_locked(std::chrono::steady_clock::time_point now) {
+    if (!guest_map.engaged.load(std::memory_order_relaxed)) return now - steady_start;
+    return guest_map.guest_anchor + (now - guest_map.host_anchor) * guest_map.rate;
+}
+
+// Earliest steady point whose guest time has reached target; never early.
+static std::chrono::steady_clock::time_point guest_host_point_locked(std::chrono::steady_clock::duration target) {
+    if (!guest_map.engaged.load(std::memory_order_relaxed)) return steady_start + target;
+    const auto delta = target - guest_map.guest_anchor;
+    if (delta <= std::chrono::steady_clock::duration::zero()) return guest_map.host_anchor + delta;
+    auto host = delta / guest_map.rate;
+    if (host * guest_map.rate < delta) host += std::chrono::steady_clock::duration{1};
+    return guest_map.host_anchor + host;
+}
+
+// The upstream primitive where its parameter type is this steady point.
+template <class TimePoint>
