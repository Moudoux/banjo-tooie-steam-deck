+static std::chrono::steady_clock::time_point quit_origin{};
+static bool closure_established = false; // Fence caller thread: set before start returns.
+bool tooie::lifecycle::terminal_closed() noexcept { return closure_established; }
+static long long quit_elapsed_ms() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - quit_origin).count();
+}
+void ultramodern::quit() {
+    // Terminal budgets count from the first quit, before stop admission and every join.
+    if (!exited.load()) quit_origin = std::chrono::steady_clock::now();
+    tooie::lifecycle::request_stop();
+    fprintf(stderr, "baseline terminal-fence stop-before-exited=%d\n", !exited.load());
+    exited.store(true);
+    GameStatus desired = GameStatus::None;
+    game_status.compare_exchange_strong(desired, GameStatus::Quit);
+    game_status.notify_all();
+}
