+    // Producer phase: its single budget counts from quit, never from this join.
+    const auto quiescence_left = std::chrono::duration_cast<std::chrono::milliseconds>(
+        quit_origin + std::chrono::seconds{3} - std::chrono::steady_clock::now());
+    if (!tooie::lifecycle::wait_for_shutdown_quiescence(quiescence_left.count() > 0 ? quiescence_left : std::chrono::milliseconds{0})) {
+        tooie::lifecycle::admit_final_drain(false);
+        const auto counts = tooie::lifecycle::counts();
+        tooie::lifecycle::fail(std::make_exception_ptr(std::runtime_error("Terminal guest fence timed out")));
+        fprintf(stderr, "baseline terminal-fence timeout retained=1 created=%zu producers=%zu enqueued=%zu deleted=%zu failure=1 elapsed_ms=%lld\n",
+            counts.created, counts.producers, counts.enqueued, counts.deleted, quit_elapsed_ms());
+        return;
+    }
+    fprintf(stderr, "baseline terminal-fence guest-quiescent=1 elapsed_ms=%lld\n", quit_elapsed_ms());
+    // Startup is joined and producers are quiescent: admit the saver's final drain. It holds
+    // no guest or renderer state, so it finishes before the renderer and cleaner joins.
+    tooie::lifecycle::admit_final_drain(true);
+    ultramodern::join_saving_thread();
+    ultramodern::join_event_threads();
+    ultramodern::join_thread_cleaner_thread();
+    const auto counts = tooie::lifecycle::counts();
+    // A recorded runtime failure with exact worker ownership still completes closure.
+    if (counts.producers || counts.created != counts.enqueued || counts.created != counts.deleted) {
+        tooie::lifecycle::fail(std::make_exception_ptr(std::runtime_error("Terminal guest fence final ownership failed")));
+        fprintf(stderr, "baseline terminal-fence failed retained=1 created=%zu producers=%zu enqueued=%zu deleted=%zu failure=1 elapsed_ms=%lld\n",
+            counts.created, counts.producers, counts.enqueued, counts.deleted, quit_elapsed_ms());
+        return;
+    }
+    tooie::lifecycle::stop_and_join_timer();
+    std::lock_guard<std::mutex> lock(current_game_mutex);
+    current_game.reset();
+    closure_established = true;
+    fprintf(stderr, "baseline terminal-fence success events=1 cleaner=1 saver=1 reset=1 retained=1 created=%zu producers=%zu enqueued=%zu deleted=%zu failure=%d elapsed_ms=%lld\n",
+        counts.created, counts.producers, counts.enqueued, counts.deleted, tooie::lifecycle::failure() ? 1 : 0, quit_elapsed_ms());
+    // One-session baseline retains RDRAM until terminal process exit.
+}
